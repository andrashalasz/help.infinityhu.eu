# Masold .env nevre, ha el akarsz terni az alapertelmezesektol.
# (A .env NINCS verziokezelve.)

# --- MariaDB ---
MARIADB_DATABASE=help_infinityhu
MARIADB_ROOT_PASSWORD=root
MARIADB_USER=help
MARIADB_PASSWORD=help

# --- a ket alkalmazas-felhasznalo (a db/05_jogosultsagok.sql hozza letre oket) ---
HELP_DB_USER=help_ro
HELP_DB_PASS=help_ro
HELP_DB_ADMIN_USER=help_rw
HELP_DB_ADMIN_PASS=help_rw

# --- portok a hoston ---
DB_PORT=3307
WEB_PORT=8080

# --- gepi forditas (nem kotelezo): none | deepl | libre | google ---
HELP_MT_PROVIDER=
HELP_MT_ENDPOINT=
HELP_MT_KEY=

# ha a beepitett LibreTranslate kontenert hasznalod:
#   docker compose --profile mt up -d
#   HELP_MT_PROVIDER=libre
#   HELP_MT_ENDPOINT=http://libretranslate:5000
MT_PORT=5050
