# Infinity Súgó – a frissítő szolgáltatás beállításai (/etc/sugo-frissito.env).
# Ebben a fájlban NINCS titok. Csak az első sor kötelező.

# A kicsomagolt git-tároló mappája – ahonnan a `docker compose` fut.
SUGO_REPO_DIR=/var/www/help.infinityhu.eu

# Melyik ágat figyelje. A frissítő csak azt telepíti, ami ezen az ágon a legújabb.
#SUGO_REMOTE=origin
#SUGO_BRANCH=main

# A compose-fájl(ok), kettősponttal elválasztva. HELYI ELTÉRÉS (más port,
# más kötet) ne a verziókövetett fájlba kerüljön, hanem egy második fájlba:
#SUGO_COMPOSE_FILES=docker-compose.yml:docker-compose.local.yml
#SUGO_COMPOSE_PROJECT=

# Az életjel címe a GAZDAGÉPRŐL nézve (a WEB_PORT szerint; alapból 8080).
#SUGO_HEALTH_URL=http://127.0.0.1:8080/health.php
# Ennyi másodpercet vár az új verzióra, mielőtt visszaállna.
#SUGO_HEALTH_TIMEOUT=240

# Szolgáltatások a compose-fájlban.
#SUGO_APP_SERVICE=php
#SUGO_DB_SERVICE=db
#SUGO_MIGRATE_SERVICE=migracio
# Amit az átváltás újraindít (adatbázis-módosításnál előtte leállít).
#SUGO_SERVICES=php web

# Az adatbázis neve, és a root jelszót tartalmazó változó neve a DB-konténerBEN.
# (A jelszót a frissítő nem látja: a konténer saját változójából olvassa.)
#SUGO_DB_NAME=help_infinityhu
#SUGO_DB_ROOT_ENV=MARIADB_ROOT_PASSWORD

# Ha ezek a mappák változnak, a frissítés az adatbázist is módosítja
# (a súgó ilyenkor pár percre leáll).
#SUGO_MIGRATION_PATHS=db/migracio

# Mappák (alapból a tárolón belül, a .gitignore kizárja őket).
#SUGO_CHANNEL_DIR=/var/www/help.infinityhu.eu/frissites
#SUGO_BACKUP_DIR=/var/www/help.infinityhu.eu/frissito-mentesek
#SUGO_STATE_DIR=/var/www/help.infinityhu.eu/.frissito

# Ennyi telepítés előtti adatbázis-mentést tart meg.
#SUGO_KEEP_BACKUPS=14
# Ennyi szabad hely kell a telepítés indításához (GB).
#SUGO_MIN_FREE_GB=3

# A tesztek képfájlja (hálózat nélkül fut).
#SUGO_TEST_IMAGE=php:8.3-cli

# A telepítés előtti mentést a frissítő PRÓBÁBÓL VISSZATÖLTI egy ideiglenes
# adatbázisba, és összeveti az eredetivel. Kikapcsolni nem ajánlott.
#SUGO_VERIFY_BACKUP=1
#SUGO_VERIFY_DB_NAME=sugo_frissito_ellenorzes
